# StockDash Environment Variables
# Copy this file to .env and fill in your values.

# --- Yahoo Finance ---
# Chart API base URL
VITE_YAHOO_API_BASE=https://query1.finance.yahoo.com/v8/finance/chart
# Crumb endpoint (used for cookie-less browser fetching through a proxy)
VITE_YAHOO_CRUMB_URL=https://query2.finance.yahoo.com/v1/test/getcrumb

# --- CORS ---
# Browser-based calls to Yahoo are CORS-blocked. Use a proxy prefix.
# Recommended: corsproxy.io (may have rate limits).
# For production, deploy your own backend proxy.
VITE_YAHOO_PROXY=https://corsproxy.io/?

# --- App defaults ---
VITE_DEFAULT_SYMBOL=AAPL
VITE_PRICE_REFRESH_INTERVAL=30000

# Optional: external news endpoint (leave empty to use Yahoo Finance)
VITE_NEWS_API_URL=

# Optional: enable native browser notifications for alerts
VITE_ENABLE_NOTIFICATIONS=false